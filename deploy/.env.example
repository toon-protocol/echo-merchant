# =============================================================================
# Echo Merchant box configuration — copy to .env and fill in.
# =============================================================================
# .env is gitignored. connector.toml, the operator credential files and
# nginx/conf.d/node.conf are rendered from it by ./render.sh.

# The zone the box's hostname lives under. One A-record must point at the box:
#   proxy.echo.${DOMAIN}   the paid ILP edge
DOMAIN=devnet.toonprotocol.dev

# Where Let's Encrypt sends expiry warnings.
LETSENCRYPT_EMAIL=you@example.com

# Leave at 1 until DNS resolves to this box, then set 0 and re-run
# ./init-letsencrypt.sh.
LETSENCRYPT_STAGING=1

# Gates the connector's /metrics and redeem endpoints. Any random secret:
#   openssl rand -hex 32
OPERATOR_BEARER_TOKEN=

# The Nostr pubkey (64 hex) permitted to sign operator writes.
OPERATOR_WRITE_KEY=

# Set to on once settlement-solana.key holds devnet SOL: the connector refuses
# to boot with an unfunded Solana settlement key. Until then the box accepts
# Base Sepolia channels only.
SETTLEMENT_SOLANA=off

# ── Optional ─────────────────────────────────────────────────────────────────

# An existing certificate lineage to keep using. Defaults to proxy.echo.${DOMAIN}.
# CERT_NAME=

# ── Running behind the shared edge (optional) ───────────────────────────────
# README.md § "Running behind the shared edge" first. Uncommenting this one line
# is the whole switch; bootstrap.sh, auto-apply.sh and a plain `docker compose`
# all read it.
#
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-edge.yml
