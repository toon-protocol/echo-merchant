# Rendered by ../render.sh -> ./conf.d/node.conf. Edit the template, not the
# rendered file.
#
# One virtual host:
#   proxy.echo.${DOMAIN}  the paid ILP edge  -> connector:4000
#
# Note what is NOT here: no location for the Echo Merchant itself. It is
# reachable only over the compose network, by the connector, as the termination
# of the priced route. A public path to it would be an unpaid door.

limit_req_zone $binary_remote_addr zone=echo:10m rate=200r/s;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name proxy.echo.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name proxy.echo.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Docker's embedded DNS, re-resolved every 10s, so the edge survives the
    # connector being recreated at a new address. Going through a variable
    # forces the runtime lookup.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location ^~ /admin { return 404; }

    location = /ilp/identity {
        add_header Access-Control-Allow-Origin "https://proxy.${DOMAIN}" always;
        add_header Vary "Origin" always;
        limit_req zone=echo burst=400 nodelay;
        set $upstream connector;
        proxy_pass http://$upstream:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        limit_req zone=echo burst=400 nodelay;
        set $upstream connector;
        proxy_pass http://$upstream:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        client_max_body_size 512k;
    }
}
