{"version": 2, "width": 120, "height": 40, "timestamp": 1792074968, "idle_time_limit": 3.0, "env": {"SHELL": "/usr/bin/bash", "TERM": "xterm-256color"}, "title": "TOON: a paid request to an app behind NAT"}
[0.010618, "o", "\r\n\u001b[1;33m# The provider: a VM on this machine, behind QEMU's user-mode NAT, no port forwarded\u001b[0m\r\n"]
[0.253473, "o", "VM started, pid 668863\r\n"]
[0.253583, "o", "\r\n\u001b[1;33m# The payer: a Linode Nanode on the public internet, tagged toon-demo\u001b[0m\r\n"]
[2.412257, "o", "payer created: id 108238183, 173.255.228.29, g6-nanode-1 in us-east, tag toon-demo\r\n"]
[91.330404, "o", "VM ready after ~60s\r\n"]
[107.355769, "o", "payer reachable over SSH\r\n"]
[141.620207, "o", "node v22.20.0, toon-client 5.0.1, Nmap version 7.95 ( https://nmap.org )\r\n"]
[141.786217, "o", "\r\n\u001b[1;33m# Provider: install toon v0.2.0\u001b[0m\r\n\u001b[1;36mprovider-vm$\u001b[0m curl -fsSL https://toon.ar.io/install.sh | TOON_VERSION=v0.2.0 sh >/dev/null 2>&1; toon --version\r\n"]
[145.382847, "o", "toon 0.2.0 (connector 7d0582e29c076318c7fbe8eacb3766c943ad44bc, relay ghcr.io/toon-protocol/relay:rust-sha-1b02f2e@sha256:3eea8d9421892a3f9617ce268db8df7432484221de08f7a217494ac0540d1059)\r\n"]
[145.386533, "o", "\r\n\u001b[1;33m# Provider: create the agent node, a hidden service by default\u001b[0m\r\n"]
[145.386552, "o", "\u001b[1;36mprovider-vm$\u001b[0m umask 077; toon init --network devnet --accept-anyone-terms --json > ~/init.json 2>/dev/null; jq -r .mnemonic ~/init.json > ~/.config/toon/mnemonic; jq \"del(.mnemonic)\" ~/init.json > ~/init.tmp && mv ~/init.tmp ~/init.json; jq \"{network, toon_apps: [.toon_apps[] | {name, reach, onion_endpoint}]}\" ~/init.json\r\n"]
[166.997815, "o", "{\r\n  \"network\": \"devnet\",\r\n  \"toon_apps\": [\r\n    {\r\n      \"name\": \"relay\",\r\n      \"reach\": \"hidden\",\r\n      \"onion_endpoint\": \"kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone\"\r\n    }\r\n  ]\r\n}\r\n"]
[167.606081, "o", "\r\n\u001b[1;33m# Provider: fund it from the devnet faucet and start it\u001b[0m\r\n"]
[167.606169, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon wallet fund 2>&1 | head -3\r\n"]
[175.205871, "o", "Asked the devnet faucet for:\r\n  0x81e79c391e8b0e52B9e0Fa1e843dB369381Eae23 (evm): asked\r\nEvery settlement key holds what `toon up` needs. Run `toon up`.\r\n"]
[175.209414, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon up\r\n"]
[175.807669, "o", "Started toon-agent-node.service (/home/toon/.config/systemd/user/toon-agent-node.service). `toon status` shows what it runs. It will start at your first login, not at boot: run `loginctl enable-linger` to change that.\r\n"]
[183.41897, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon status\r\n"]
[184.017162, "o", "Supervisor: running.\r\nUnconnected: it has joined no network. `toon join <network> --deposit <amount> --yes` connects it.\r\nTOON app relay (ILP address g.toon.245af228762c9581): connector running on 127.0.0.1:28872.\r\nApp relay of relay: running on 127.0.0.1:62445. Read at ws://127.0.0.1:63844. Route g.toon.245af228762c9581.relay at price 1.\r\nSubscriptions held: 0 with a balance, 0 exhausted.\r\nSubscriber keys of its own relay with a balance: 0.\r\n"]
[184.020831, "o", "\r\n\u001b[1;33m# Provider: put the Echo Merchant behind the connector, at price 2\u001b[0m\r\n\u001b[1;36mprovider-vm$\u001b[0m toon add echo --to relay --image ghcr.io/toon-protocol/echo-merchant:release --env ECHO_MERCHANT_ADDR=0.0.0.0:3100 --price 2 --yes\r\n"]
[190.122043, "o", "Added echo behind relay: packets to g.toon.245af228762c9581.echo are delivered to it, at price 2. The connector of relay restarted.\r\n"]
[190.125764, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon route list\r\n"]
[190.723697, "o", "g.toon.245af228762c9581.relay -> http://127.0.0.1:62445/write (price 1)\r\ng.toon.245af228762c9581.relay.ephemeral -> http://127.0.0.1:62445/write-ephemeral (price 0)\r\ng.toon.245af228762c9581.echo -> http://172.18.0.2:3100/ (price 2)\r\n"]
[190.72724, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon status | grep -E \"^(Supervisor|TOON app|App echo)\"\r\n"]
[191.32524, "o", "Supervisor: running.\r\nTOON app relay (ILP address g.toon.245af228762c9581): connector running on 127.0.0.1:28872.\r\nApp echo of relay: running on 172.18.0.2:3100. Read at ws://172.18.0.2:7100. Route g.toon.245af228762c9581.echo at price 2.\r\n"]
[191.933431, "o", "\r\n\u001b[1;33m# Payer: where it is. A different network: a Linode on the public internet\u001b[0m\r\n\u001b[1;36mlinode-payer#\u001b[0m curl -4 -fsS https://ifconfig.me; echo; hostname\r\n"]
[192.846654, "o", "173.255.228.29\r\n"]
[192.854544, "o", "localhost\r\n"]
[192.856085, "o", "\r\n\u001b[1;33m# Payer: read the provider's self-description through the Anyone overlay (free)\u001b[0m\r\n"]
[192.856154, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone; P='--password-file /root/.toon/password'; npx toon-client describe $P 2>&1 | grep -v -E '^toon-client: (downloading|verified)'\r\n"]
[208.804641, "o", "toon-client: http://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone is a hidden service; starting a local anon daemon\r\ntoon-client: starting anon v0.4.10.2 on 127.0.0.1:35037 (/root/.toon/anon/v0.4.10.2/anon)\r\ntoon-client: anon is listening; building circuits on demand\r\ntoon-client: proxying through socks5h://127.0.0.1:35037\r\n  connector  http://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone\r\n  addresses  g.toon.245af228762c9581\r\n  http       http://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone/ilp\r\n  btp        ws://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone/ilp/btp\r\n"]
[208.80473, "o", "  seals to   0x04245af228762c95814a68f19573b7d05db0af146414a7cc1969a4c69d1a911d9e34619c838f89759da4c729ed128356c980c3e3634f05d9a4c7f524b3f1765a57 (key connector-signer)\r\n  versions   1 (default 1)\r\n\r\nChannels (x402 batch-settlement):\r\n  eip155:84532  payTo 0x81e79c391e8b0e52b9e0fa1e843db369381eae23  token 0x0c996d7c934c79a6255254875607fe69df25c0e1  min delay 86400s\r\n\r\nRoutes:\r\n  g.toon.245af228762c9581.echo             2 (0.000002 USDC)\r\n  g.toon.245af228762c9581.relay            1 (0.000001 USDC)\r\n  g.toon.245af228762c9581.relay.ephemeral  0 (0 USDC)\r\n"]
[208.810182, "o", "\r\n\u001b[1;33m# Payer: test USDC from the devnet faucet, and a channel toward the provider (no gas)\u001b[0m\r\n"]
[208.810229, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone; P='--password-file /root/.toon/password'; npx toon-client faucet $P 2>&1 | grep -v '^toon-client:'\r\n"]
[217.260697, "o", "Faucet request accepted.\r\n  chain    evm\r\n  address  0x19F6A53F41Fc46F91C0F7F97799128fD9CF44186\r\n\r\nCheck it landed with 'toon-client balances'.\r\n"]
[217.262267, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone; P='--password-file /root/.toon/password'; npx toon-client channel open --deposit 100000 $P 2>&1 | grep -v '^toon-client:'\r\n"]
[226.277092, "o", "Channel open.\r\n  channel    0x751d362225b3b9449dd0b4da4c9aded821470bc267c9dcec9da1d6ed3bbac164\r\n  network    eip155:84532\r\n  deposit    100000 (0.1 USDC)\r\n  signed     0 (0 USDC)\r\n  available  100000 (0.1 USDC)\r\n"]
[226.286518, "o", "\r\n\u001b[1;33m# Payer: one paid request to the Echo Merchant behind NAT\u001b[0m\r\n"]
[226.286585, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://kffg6sbeivhl5i42khlcj2stapdeioenncffnlvgmpfflnx65tt7qtyd.anyone; P='--password-file /root/.toon/password'; npx toon-client send g.toon.245af228762c9581.echo --json-body --body '{\"hello\":\"from a linode\"}' $P 2>&1 | grep -v '^toon-client:'\r\n"]
[234.655508, "o", "FULFILL 200  (http)\r\n  paid        2 (0.000002 USDC)  channel 0x751d362225b3b9449dd0b4da4c9aded821470bc267c9dcec9da1d6ed3bbac164\r\n  cumulative  2 (0.000002 USDC)\r\n\r\n  content-type:    application/json\r\n  content-length:  368\r\n  date:            Thu, 15 Oct 2026 14:40:02 GMT\r\n\r\n"]
[234.655614, "o", "{\"payment\":{\"amount\":\"2\",\"chain\":\"evm\",\"payer\":\"evm:0x751d362225b3b9449dd0b4da4c9aded821470bc267c9dcec9da1d6ed3bbac164\"},\"request\":{\"body\":\"{\\\"hello\\\":\\\"from a linode\\\"}\",\"body_encoding\":\"utf8\",\"headers\":{\"accept\":\"*/*\",\"accept-encoding\":\"gzip, br, deflate\",\"content-length\":\"25\",\"content-type\":\"application/json\",\"host\":\"172.18.0.2:3100\"},\"method\":\"POST\",\"path\":\"/\"}}\r\n"]
[234.656961, "o", "\r\n\u001b[1;33m# Provider: the channel the payment arrived on\u001b[0m\r\n"]
[234.657011, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel list\r\n"]
[235.274086, "o", "0x751d362225b3b9449dd0b4da4c9aded821470bc267c9dcec9da1d6ed3bbac164 evm inbound open (counterparty 0x19f6a53f41fc46f91c0f7f97799128fd9cf44186, collateral 100000, landed 0, watermark 2)\r\n"]
[235.279169, "o", "\r\n\u001b[1;33m# Provider VM: every listening TCP socket. All on loopback\u001b[0m\r\n\u001b[1;36mprovider-vm#\u001b[0m ss -tlnp\r\n"]
[235.875885, "o", "State  Recv-Q Send-Q Local Address:Port  Peer Address:PortProcess                                    \r\n"]
[235.875991, "o", "LISTEN 0      4096       127.0.0.1:44963      0.0.0.0:*    users:((\"containerd\",pid=1739))      \r\nLISTEN 0      128        127.0.0.1:62445      0.0.0.0:*    users:((\"relay\",pid=2455))          \r\nLISTEN 0      4096       127.0.0.1:62028      0.0.0.0:*    users:((\"anon\",pid=2386))            \r\nLISTEN 0      4096      127.0.0.54:53         0.0.0.0:*    users:((\"systemd-resolve\",pid=2129))\r\nLISTEN 0      128        127.0.0.1:63844      0.0.0.0:*    users:((\"relay\",pid=2455))          \r\nLISTEN 0      4096   127.0.0.53%lo:53         0.0.0.0:*    users:((\"systemd-resolve\",pid=2129))\r\n"]
[235.876026, "o", "LISTEN 0      128        127.0.0.1:28872      0.0.0.0:*    users:((\"toon\",pid=2655))           \r\n"]
[235.880015, "o", "\r\n\u001b[1;33m# Host: the QEMU process holds no listening socket, so nothing forwards into the VM\u001b[0m\r\n"]
[235.880062, "o", "\u001b[1;36mhost$\u001b[0m ss -tlnp | grep qemu || echo 'no listening socket'\r\n"]
[235.903558, "o", "no listening socket\r\n"]
[235.903696, "o", "\r\n\u001b[1;33m# Payer: scan the home's public address (masked here) from the Linode\u001b[0m\r\n"]
[235.904935, "o", "\u001b[1;36mlinode-payer#\u001b[0m nmap -n -Pn -T4 --top-ports 1000 <home-ip>\r\n"]
[337.730573, "o", "All 1000 scanned ports on <home-ip> are in ignored states.\r\nNot shown: 1000 filtered tcp ports (no-response)\r\n\r\nNmap done: 1 IP address (1 host up) scanned in 101.20 seconds\r\n"]
[337.731944, "o", "\u001b[1;36mlinode-payer#\u001b[0m nmap -n -Pn -p 22,80,443,7100 <home-ip>\r\n"]
[341.674446, "o", "PORT     STATE    SERVICE\r\n22/tcp   filtered ssh\r\n80/tcp   filtered http\r\n443/tcp  filtered https\r\n7100/tcp filtered font-service\r\n"]
[341.675998, "o", "\r\n\u001b[1;33m# Tear down: the Linode payer, then the provider VM\u001b[0m\r\n"]
