{"version": 2, "width": 120, "height": 40, "timestamp": 1792082832, "idle_time_limit": 3.0, "env": {"SHELL": "/usr/bin/bash", "TERM": "xterm-256color"}, "title": "TOON: a paid request to an app behind NAT"}
[0.010283, "o", "\r\n\u001b[1;33m# The provider: a VM on this machine, behind QEMU's user-mode NAT, no port forwarded\u001b[0m\r\n"]
[0.11748, "o", "VM started, pid 300024\r\n\r\n\u001b[1;33m# The payer: a Linode Nanode on the public internet, tagged toon-demo\u001b[0m\r\n"]
[2.276718, "o", "payer created: id 108247707, 45.33.87.160, g6-nanode-1 in us-east, tag toon-demo\r\n"]
[139.407555, "o", "VM ready after ~90s\r\n"]
[140.251983, "o", "payer reachable over SSH\r\n"]
[182.261886, "o", "node v22.20.0, toon-client 5.0.1, Nmap version 7.95 ( https://nmap.org )\r\n"]
[182.404716, "o", "\r\n\u001b[1;33m# Provider: install toon v0.2.0\u001b[0m\r\n"]
[182.404815, "o", "\u001b[1;36mprovider-vm$\u001b[0m curl -fsSL https://toon.ar.io/install.sh | TOON_VERSION=v0.2.0 sh >/dev/null 2>&1; toon --version\r\n"]
[185.452325, "o", "toon 0.2.0 (connector 7d0582e29c076318c7fbe8eacb3766c943ad44bc, relay ghcr.io/toon-protocol/relay:rust-sha-1b02f2e@sha256:3eea8d9421892a3f9617ce268db8df7432484221de08f7a217494ac0540d1059)\r\n"]
[185.455966, "o", "\r\n\u001b[1;33m# Provider: create the agent node, a hidden service by default\u001b[0m\r\n"]
[185.456001, "o", "\u001b[1;36mprovider-vm$\u001b[0m umask 077; toon init --network devnet --accept-anyone-terms --json > ~/init.json 2>/dev/null; jq -r .mnemonic ~/init.json > ~/.config/toon/mnemonic; jq \"del(.mnemonic)\" ~/init.json > ~/init.tmp && mv ~/init.tmp ~/init.json; jq \"{network, toon_apps: [.toon_apps[] | {name, reach, onion_endpoint}]}\" ~/init.json\r\n"]
[236.586792, "o", "{\r\n  \"network\": \"devnet\",\r\n  \"toon_apps\": [\r\n    {\r\n      \"name\": \"relay\",\r\n      \"reach\": \"hidden\",\r\n      \"onion_endpoint\": \"ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone\"\r\n    }\r\n  ]\r\n}\r\n"]
[237.194646, "o", "\r\n\u001b[1;33m# Provider: fund it from the devnet faucet and start it\u001b[0m\r\n"]
[237.194742, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon wallet fund 2>&1 | head -3\r\n"]
[259.805354, "o", "Asked the devnet faucet for:\r\n  0x79EB3dB29f3664fFb3a053A549553283151cBA0d (evm): asked\r\nEvery settlement key holds what `toon up` needs. Run `toon up`.\r\n"]
[260.410828, "o", "\r\n\u001b[1;33m# Provider: Base Sepolia ETH for the settlement key's gas (toon_cli#255)\u001b[0m\r\n"]
[260.410935, "o", "\u001b[1;36mhost$\u001b[0m cast send --mnemonic \"$GAS_FUNDER_MNEMONIC\" --value 0.002ether 0x79EB3dB29f3664fFb3a053A549553283151cBA0d\r\n"]
[262.822942, "o", "funding tx 0x75597b93ddb9f6aa98c452dae76083c2d148fc54082fbc71aa45df2d551cd4a4 (status 0x1)\r\nhttps://sepolia.basescan.org/tx/0x75597b93ddb9f6aa98c452dae76083c2d148fc54082fbc71aa45df2d551cd4a4\r\n"]
[268.313541, "o", "0x79EB3dB29f3664fFb3a053A549553283151cBA0d holds 0.002000000000000000 ETH\r\n"]
[268.313622, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon up\r\n"]
[268.916772, "o", "Started toon-agent-node.service (/home/toon/.config/systemd/user/toon-agent-node.service). `toon status` shows what it runs. It will start at your first login, not at boot: run `loginctl enable-linger` to change that.\r\n"]
[276.528111, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon status\r\n"]
[277.126422, "o", "Supervisor: running.\r\nUnconnected: it has joined no network. `toon join <network> --deposit <amount> --yes` connects it.\r\nTOON app relay (ILP address g.toon.0206ab32151f7edb): connector running on 127.0.0.1:28084.\r\nApp relay of relay: running on 127.0.0.1:63335. Read at ws://127.0.0.1:63043. Route g.toon.0206ab32151f7edb.relay at price 1.\r\nSubscriptions held: 0 with a balance, 0 exhausted.\r\nSubscriber keys of its own relay with a balance: 0.\r\n"]
[277.130165, "o", "\r\n\u001b[1;33m# Provider: join the devnet. A peering toward its hub, with a deposit\u001b[0m\r\n"]
[277.13025, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon join devnet --deposit 1000000 --yes\r\n"]
[284.73221, "o", "Joined devnet: peered with https://proxy.relay.devnet.toonprotocol.dev/ilp and forwarding g.toon to it, deposit 1000000. Reading its relay at wss://relay-ws.devnet.toonprotocol.dev.\r\nIts connector forwards back to you only if its operator creates a peering toward you in return.\r\n"]
[284.735696, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon peer list\r\n"]
[285.33383, "o", "devnet (fee 0, cap 1000000)\r\n"]
[285.33744, "o", "\r\n\u001b[1;33m# Provider: put the Echo Merchant behind the connector, at price 2\u001b[0m\r\n"]
[285.337512, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon add echo --to relay --image ghcr.io/toon-protocol/echo-merchant:release --env ECHO_MERCHANT_ADDR=0.0.0.0:3100 --price 2 --yes\r\n"]
[298.442703, "o", "Added echo behind relay: packets to g.toon.0206ab32151f7edb.echo are delivered to it, at price 2. The connector of relay restarted.\r\n"]
[298.446321, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon route list\r\n"]
[299.044228, "o", "g.toon.0206ab32151f7edb.relay -> http://127.0.0.1:63335/write (price 1)\r\ng.toon.0206ab32151f7edb.relay.ephemeral -> http://127.0.0.1:63335/write-ephemeral (price 0)\r\ng.toon.0206ab32151f7edb.echo -> http://172.18.0.2:3100/ (price 2)\r\ng.toon -> peer devnet (price 0)\r\n"]
[299.047582, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon status | grep -E \"^(Supervisor|TOON app|App echo)\"\r\n"]
[299.645836, "o", "Supervisor: running.\r\nTOON app relay (ILP address g.toon.0206ab32151f7edb): connector running on 127.0.0.1:28084.\r\nApp echo of relay: running on 172.18.0.2:3100. Read at ws://172.18.0.2:7100. Route g.toon.0206ab32151f7edb.echo at price 2.\r\n"]
[300.857708, "o", "\r\n\u001b[1;33m# Hub: the devnet relay's operator peers toward the provider's .anyone address, and routes its app\u001b[0m\r\n(join made the provider's peering toward the relay. The relay learns no routes, so its operator peers back.)\r\n\u001b[1;36mrelay-operator#\u001b[0m ./runtime-peerings.sh node demo-0206ab32151f7edb http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone/ilp g.toon.0206ab32151f7edb.echo 100000 3\r\n"]
[306.75593, "o", "batch-settlement backend error: the opening deposit into '0x86025dcf86b8866ed47690523e60ceb591c7ee3992533f6b5f6acb5a29d54509' confirmed, and the chain shows no balance there\r\n"]
[306.827827, "o", "route 'g.toon.0206ab32151f7edb.echo' names unknown peer 'demo-0206ab32151f7edb'\r\n"]
[306.974419, "o", "(the relay's RPC had not yet seen the deposit; the write is idempotent, so again)\r\n"]
[318.470471, "o", "{\"id\":\"demo-0206ab32151f7edb\",\"fee\":1,\"max_packet_amount\":100000,\"source\":\"runtime\",\"channel\":{\"id\":\"0x86025dcf86b8866ed47690523e60ceb591c7ee3992533f6b5f6acb5a29d54509\",\"status\":\"created\",\"chain\":\"evm\"}}\r\n"]
[318.537408, "o", "{\"prefix\":\"g.toon.0206ab32151f7edb.echo\",\"peer_id\":\"demo-0206ab32151f7edb\",\"price\":3,\"source\":\"runtime\"}\r\n"]
[318.68879, "o", "\u001b[1;36manyone$\u001b[0m curl -s https://proxy.relay.devnet.toonprotocol.dev/ilp | jq -r '.routes[].prefix'\r\n"]
[318.827857, "o", "g.toon.0206ab32151f7edb.echo\r\ng.toon.echo\r\ng.toon.relay\r\ng.toon.relay.ephemeral\r\ng.toon.relay.gas\r\ng.toon.relay.store\r\n"]
[318.829118, "o", "\r\n\u001b[1;33m# Payer: pay the app behind NAT through the devnet relay, at its public https address\u001b[0m\r\n(the payer runs no anon daemon. The relay carries the packet over the Anyone overlay to the provider.)\r\n"]
[319.752268, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; node pay-via-hub.mjs https://proxy.relay.devnet.toonprotocol.dev g.toon.0206ab32151f7edb.echo 0x040206ab32151f7edb937ca74b3ec2d3eb4adb8bb921dd117618a7f504930374d684edf2742f7bd83242fcf3520e6b324f68a5ba117a3f52d12da9cb91fa9af9c9 'from a linode, through the devnet relay'\r\n"]
[335.385043, "o", "channel to the hub  0xba5f835de777f60ddff4738312b697cbe867cb99908bbb773b09747e6344229e  deposit 100000\r\n"]
[337.61011, "o", "FULFILL 200  paid 3 to the hub\r\n{\"payment\":{\"amount\":\"2\",\"chain\":\"evm\",\"payer\":\"evm:0x86025dcf86b8866ed47690523e60ceb591c7ee3992533f6b5f6acb5a29d54509\"},\"request\":{\"body\":\"{\\\"hello\\\":\\\"from a linode, through the devnet relay\\\"}\",\"body_encoding\":\"utf8\",\"headers\":{\"accept\":\"*/*\",\"accept-encoding\":\"gzip, br, deflate\",\"content-length\":\"51\",\"content-type\":\"application/json\",\"host\":\"172.18.0.2:3100\"},\"method\":\"POST\",\"path\":\"/\"}}\r\n"]
[337.621913, "o", "\r\n\u001b[1;33m# Payer: where it is. A different network: a Linode on the public internet\u001b[0m\r\n"]
[337.621957, "o", "\u001b[1;36mlinode-payer#\u001b[0m curl -4 -fsS https://ifconfig.me; echo; hostname\r\n"]
[338.296963, "o", "45.33.87.160\r\n"]
[338.301074, "o", "localhost\r\n"]
[338.302656, "o", "\r\n\u001b[1;33m# Payer: read the provider's self-description through the Anyone overlay (free)\u001b[0m\r\n"]
[338.302724, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone; P='--password-file /root/.toon/password'; npx toon-client describe $P 2>&1 | grep -v -E '^toon-client: (downloading|verified)'\r\n"]
[358.163158, "o", "toon-client: http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone is a hidden service; starting a local anon daemon\r\ntoon-client: starting anon v0.4.10.2 on 127.0.0.1:43335 (/root/.toon/anon/v0.4.10.2/anon)\r\ntoon-client: anon is listening; building circuits on demand\r\ntoon-client: proxying through socks5h://127.0.0.1:43335\r\n  connector  http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone\r\n  addresses  g.toon.0206ab32151f7edb\r\n  http       http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone/ilp\r\n  btp        ws://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone/ilp/btp\r\n  seals to   0x040206ab32151f7edb937ca74b3ec2d3eb4adb8bb921dd117618a7f504930374d684edf2742f7bd83242fcf3520e6b324f68a5ba117a3f52d12da9cb91fa9af9c9 (key connector-signer)\r\n  versions   1 (default 1)\r\n\r\nChannels (x402 batch-settlement):\r\n  eip155:84532  payTo 0x79eb3db29f3664ffb3a053a549553283151cba0d  token 0x0c996d7c934c79a6255254875607fe69df25c0e1  min delay 86400s\r\n\r\nRoutes:\r\n  g.toon                                   0 (0 USDC)\r\n  g.toon.0206ab32151f7edb.echo             2 (0.000002 USDC)\r\n  g.toon.0206ab32151f7edb.relay            1 (0.000001 USDC)\r\n  g.toon.0206ab32151f7edb.relay.ephemeral  0 (0 USDC)\r\n"]
[358.164709, "o", "\r\n\u001b[1;33m# Payer: test USDC from the devnet faucet, and a channel toward the provider (no gas)\u001b[0m\r\n"]
[358.164764, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone; P='--password-file /root/.toon/password'; npx toon-client faucet $P 2>&1 | grep -v '^toon-client:'\r\n"]
[372.015043, "o", "Faucet request accepted.\r\n  chain    evm\r\n  address  0x06b72e76eEDECB0967A86C8b96C0ad4B0E7Dc7F1\r\n\r\nCheck it landed with 'toon-client balances'.\r\n"]
[372.016586, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone; P='--password-file /root/.toon/password'; npx toon-client channel open --deposit 100000 $P 2>&1 | grep -v '^toon-client:'\r\n"]
[381.466576, "o", "Channel open.\r\n  channel    0xd232b9df43663eda438d9d296effd8d4e5831267ed400636c261d390101f6499\r\n  network    eip155:84532\r\n  deposit    100000 (0.1 USDC)\r\n  signed     0 (0 USDC)\r\n  available  100000 (0.1 USDC)\r\n"]
[381.475941, "o", "\r\n\u001b[1;33m# Payer: one paid request to the Echo Merchant behind NAT\u001b[0m\r\n"]
[381.475973, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ufnjnqsmav5ayhjjgoqsm3ruzpgrwv4hbojomiisi4aa2exrld44tbad.anyone; P='--password-file /root/.toon/password'; npx toon-client send g.toon.0206ab32151f7edb.echo --json-body --body '{\"hello\":\"from a linode\"}' $P 2>&1 | grep -v '^toon-client:'\r\n"]
[393.839247, "o", "FULFILL 200  (http)\r\n  paid        2 (0.000002 USDC)  channel 0xd232b9df43663eda438d9d296effd8d4e5831267ed400636c261d390101f6499\r\n  cumulative  2 (0.000002 USDC)\r\n\r\n  content-type:    application/json\r\n  content-length:  368\r\n  date:            Thu, 15 Oct 2026 16:53:46 GMT\r\n\r\n{\"payment\":{\"amount\":\"2\",\"chain\":\"evm\",\"payer\":\"evm:0xd232b9df43663eda438d9d296effd8d4e5831267ed400636c261d390101f6499\"},\"request\":{\"body\":\"{\\\"hello\\\":\\\"from a linode\\\"}\",\"body_encoding\":\"utf8\",\"headers\":{\"accept\":\"*/*\",\"accept-encoding\":\"gzip, br, deflate\",\"content-length\":\"25\",\"content-type\":\"application/json\",\"host\":\"172.18.0.2:3100\"},\"method\":\"POST\",\"path\":\"/\"}}\r\n"]
[393.84069, "o", "\r\n\u001b[1;33m# Provider: the channel the payment arrived on\u001b[0m\r\n"]
[393.840744, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel list\r\n"]
[395.437345, "o", "0x86025dcf86b8866ed47690523e60ceb591c7ee3992533f6b5f6acb5a29d54509 evm inbound open (counterparty 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308, collateral 100000, landed 0, watermark 2)\r\n0xd232b9df43663eda438d9d296effd8d4e5831267ed400636c261d390101f6499 evm inbound open (counterparty 0x06b72e76eedecb0967a86c8b96c0ad4b0e7dc7f1, collateral 100000, landed 0, watermark 2)\r\n0x1793ab4182424eb9b693938d3c6f0b3e3004d2f2828106ba8d869c2323b2f327 evm outbound open (counterparty 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308, collateral 1000000, landed 0, watermark 0)\r\n"]
[395.440926, "o", "\r\n\u001b[1;33m# Provider: land what it was paid on Base Sepolia now, instead of at the next ten-minute sweep\u001b[0m\r\n"]
[395.440962, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel list | grep inbound\r\n"]
[396.539138, "o", "0x86025dcf86b8866ed47690523e60ceb591c7ee3992533f6b5f6acb5a29d54509 evm inbound open (counterparty 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308, collateral 100000, landed 0, watermark 2)\r\n0xd232b9df43663eda438d9d296effd8d4e5831267ed400636c261d390101f6499 evm inbound open (counterparty 0x06b72e76eedecb0967a86c8b96c0ad4b0e7dc7f1, collateral 100000, landed 0, watermark 2)\r\n"]
[398.346804, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel land 0x86025dcf86b8866ed47690523e60ceb591c7ee3992533f6b5f6acb5a29d54509\r\n"]
[401.946673, "o", "Landed: 0x86025dcf86b8866ed47690523e60ceb591c7ee3992533f6b5f6acb5a29d54509 evm inbound open (counterparty 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308, collateral 99998, landed 2, watermark 2)\r\n"]
[416.643028, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel land 0xd232b9df43663eda438d9d296effd8d4e5831267ed400636c261d390101f6499\r\n"]
[422.171408, "o", "Landed: 0xd232b9df43663eda438d9d296effd8d4e5831267ed400636c261d390101f6499 evm inbound open (counterparty 0x06b72e76eedecb0967a86c8b96c0ad4b0e7dc7f1, collateral 99998, landed 2, watermark 2)\r\n"]
[439.113878, "o", "(the inbound channel whose counterparty is 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308 is the devnet relay's)\r\n"]
[439.113987, "o", "\r\n\u001b[1;33m# Provider: pay a devnet route from behind NAT, hop by hop: this node, the devnet relay, the gas station\u001b[0m\r\n\u001b[1;36mprovider-vm$\u001b[0m echo \"{\\\"hello\\\":\\\"from behind NAT\\\"}\" > ~/body.json; toon probe g.toon.relay.gas --seal-to https://proxy.gas.devnet.toonprotocol.dev/ilp\r\n"]
[440.710668, "o", "Rejected with F06: 0 base units to g.toon.relay.gas. No payment channel claim attached (peer 'devnet' quotes 1001 for this packet, which carried only 0: raise the amount to at least 1001) The path costs 1001 base units: state `toon send --amount 1001`.\r\n"]
[440.714193, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon send g.toon.relay.gas --amount 1001 --seal-to https://proxy.gas.devnet.toonprotocol.dev/ilp --body ~/body.json --yes\r\n"]
[443.313407, "o", "Fulfilled: 1001 base units to g.toon.relay.gas. The app answered 422.\r\n"]
[443.317132, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel list | grep outbound\r\n"]
[444.415358, "o", "0x1793ab4182424eb9b693938d3c6f0b3e3004d2f2828106ba8d869c2323b2f327 evm outbound open (counterparty 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308, collateral 1000000, landed 0, watermark 1001)\r\n"]
[444.419075, "o", "\r\n\u001b[1;33m# Provider VM: every listening TCP socket. All on loopback\u001b[0m\r\n\u001b[1;36mprovider-vm#\u001b[0m ss -tlnp\r\n"]
[445.017276, "o", "State  Recv-Q Send-Q Local Address:Port  Peer Address:PortProcess                                    \r\n"]
[445.017404, "o", "LISTEN 0      4096   127.0.0.53%lo:53         0.0.0.0:*    users:((\"systemd-resolve\",pid=2121))\r\nLISTEN 0      4096       127.0.0.1:33203      0.0.0.0:*    users:((\"containerd\",pid=1731))      \r\nLISTEN 0      4096      127.0.0.54:53         0.0.0.0:*    users:((\"systemd-resolve\",pid=2121))\r\nLISTEN 0      128        127.0.0.1:28084      0.0.0.0:*    users:((\"toon\",pid=2732))           \r\nLISTEN 0      4096       127.0.0.1:61402      0.0.0.0:*    users:((\"anon\",pid=2384))            \r\nLISTEN 0      128        127.0.0.1:63335      0.0.0.0:*    users:((\"relay\",pid=2453))          \r\nLISTEN 0      128        127.0.0.1:63043      0.0.0.0:*    users:((\"relay\",pid=2453))          \r\n"]
[445.020781, "o", "\r\n\u001b[1;33m# Host: the QEMU process holds no listening socket, so nothing forwards into the VM\u001b[0m\r\n"]
[445.020858, "o", "\u001b[1;36mhost$\u001b[0m ss -tlnp | grep qemu || echo 'no listening socket'\r\n"]
[445.060066, "o", "no listening socket\r\n"]
[445.060172, "o", "\r\n\u001b[1;33m# Payer: scan the home's public address (masked here) from the Linode\u001b[0m\r\n"]
[445.061266, "o", "\u001b[1;36mlinode-payer#\u001b[0m nmap -n -Pn -T4 --top-ports 1000 <home-ip>\r\n"]
[547.16967, "o", "All 1000 scanned ports on <home-ip> are in ignored states.\r\nNot shown: 1000 filtered tcp ports (no-response)\r\n\r\nNmap done: 1 IP address (1 host up) scanned in 101.20 seconds\r\n"]
[547.1755, "o", "\u001b[1;36mlinode-payer#\u001b[0m nmap -n -Pn -p 22,80,443,7100 <home-ip>\r\n"]
[550.884627, "o", "PORT     STATE    SERVICE\r\n22/tcp   filtered ssh\r\n80/tcp   filtered http\r\n443/tcp  filtered https\r\n7100/tcp filtered font-service\r\n"]
[550.886142, "o", "\r\n\u001b[1;33m# Tear down: the devnet relay's route and peering toward the provider\u001b[0m\r\n"]
[550.886211, "o", "\u001b[1;36mrelay-operator#\u001b[0m ./runtime-peerings.sh remove demo-0206ab32151f7edb g.toon.0206ab32151f7edb.echo\r\n"]
[552.692623, "o", "the relay no longer peers toward demo-0206ab32151f7edb or routes g.toon.0206ab32151f7edb.echo. Its peers: gas echo store \r\n"]
[552.693292, "o", "\r\n\u001b[1;33m# Tear down: the Linode payer, then the provider VM\u001b[0m\r\n"]
[554.783271, "o", "payer deleted: id 108247707 (toon-demo-payer-1792082832)\r\n"]
[555.124589, "o", "instances tagged toon-demo now: 0\r\n"]
[555.127091, "o", "VM stopped\r\n"]
