[303.332593, "o", "\r\n\u001b[1;33m# Host: the QEMU process holds no listening socket, so nothing forwards into the VM\u001b[0m\r\n"]
[303.33265, "o", "\u001b[1;36mhost$\u001b[0m ss -tlnp | grep qemu || echo 'no listening socket'\r\n"]
[303.363482, "o", "no listening socket\r\n"]
[303.363614, "o", "\r\n\u001b[1;33m# Payer: scan the home's public address (masked here) from the Linode\u001b[0m\r\n"]
[303.364536, "o", "\u001b[1;36mlinode-payer#\u001b[0m nmap -n -Pn -T4 --top-ports 1000 <home-ip>\r\n"]
