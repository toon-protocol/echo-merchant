{"version": 2, "width": 120, "height": 40, "timestamp": 1792076294, "idle_time_limit": 3.0, "env": {"SHELL": "/usr/bin/bash", "TERM": "xterm-256color"}, "title": "TOON: a paid request to an app behind NAT"}
[0.010561, "o", "\r\n\u001b[1;33m# The provider: a VM on this machine, behind QEMU's user-mode NAT, no port forwarded\u001b[0m\r\n"]
[0.116055, "o", "VM started, pid 749005\r\n\r\n\u001b[1;33m# The payer: a Linode Nanode on the public internet, tagged toon-demo\u001b[0m\r\n"]
[2.359527, "o", "payer created: id 108239969, 45.33.87.160, g6-nanode-1 in us-east, tag toon-demo\r\n"]
[99.330173, "o", "VM ready after ~65s\r\n"]
[100.128017, "o", "payer reachable over SSH\r\n"]
[136.620593, "o", "node v22.20.0, toon-client 5.0.1, Nmap version 7.95 ( https://nmap.org )\r\n"]
[136.782558, "o", "\r\n\u001b[1;33m# Provider: install toon v0.2.0\u001b[0m\r\n\u001b[1;36mprovider-vm$\u001b[0m curl -fsSL https://toon.ar.io/install.sh | TOON_VERSION=v0.2.0 sh >/dev/null 2>&1; toon --version\r\n"]
[139.867646, "o", "toon 0.2.0 (connector 7d0582e29c076318c7fbe8eacb3766c943ad44bc, relay ghcr.io/toon-protocol/relay:rust-sha-1b02f2e@sha256:3eea8d9421892a3f9617ce268db8df7432484221de08f7a217494ac0540d1059)\r\n"]
[139.871594, "o", "\r\n\u001b[1;33m# Provider: create the agent node, a hidden service by default\u001b[0m\r\n"]
[139.871677, "o", "\u001b[1;36mprovider-vm$\u001b[0m umask 077; toon init --network devnet --accept-anyone-terms --json > ~/init.json 2>/dev/null; jq -r .mnemonic ~/init.json > ~/.config/toon/mnemonic; jq \"del(.mnemonic)\" ~/init.json > ~/init.tmp && mv ~/init.tmp ~/init.json; jq \"{network, toon_apps: [.toon_apps[] | {name, reach, onion_endpoint}]}\" ~/init.json\r\n"]
[163.983065, "o", "{\r\n  \"network\": \"devnet\",\r\n  \"toon_apps\": [\r\n    {\r\n      \"name\": \"relay\",\r\n      \"reach\": \"hidden\",\r\n      \"onion_endpoint\": \"ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone\"\r\n    }\r\n  ]\r\n}\r\n"]
[164.590756, "o", "\r\n\u001b[1;33m# Provider: fund it from the devnet faucet and start it\u001b[0m\r\n\u001b[1;36mprovider-vm$\u001b[0m toon wallet fund 2>&1 | head -3\r\n"]
[174.692578, "o", "Asked the devnet faucet for:\r\n  0xAA078CfaB21404715AD618C5e8B10674CdA552Ca (evm): asked\r\nEvery settlement key holds what `toon up` needs. Run `toon up`.\r\n"]
[175.297652, "o", "\r\n\u001b[1;33m# Provider: Base Sepolia ETH for the settlement key's gas (toon_cli#255)\u001b[0m\r\n"]
[175.297765, "o", "\u001b[1;36mhost$\u001b[0m cast send --mnemonic \"$GAS_FUNDER_MNEMONIC\" --value 0.002ether 0xAA078CfaB21404715AD618C5e8B10674CdA552Ca\r\n"]
[175.761466, "o", "funding tx 0x9c31ea796af4096ce13bcd31cc8af472ed042a630cf7ab1f1dc503d2bc8a1455 (status 0x1)\r\nhttps://sepolia.basescan.org/tx/0x9c31ea796af4096ce13bcd31cc8af472ed042a630cf7ab1f1dc503d2bc8a1455\r\n"]
[181.172042, "o", "0xAA078CfaB21404715AD618C5e8B10674CdA552Ca holds 0.002000000000000000 ETH\r\n"]
[181.172142, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon up\r\n"]
[181.701801, "o", "Started toon-agent-node.service (/home/toon/.config/systemd/user/toon-agent-node.service). `toon status` shows what it runs. It will start at your first login, not at boot: run `loginctl enable-linger` to change that.\r\n"]
[195.317481, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon status\r\n"]
[195.915511, "o", "Supervisor: running.\r\nUnconnected: it has joined no network. `toon join <network> --deposit <amount> --yes` connects it.\r\nTOON app relay (ILP address g.toon.151cc3609b6b5c30): connector running on 127.0.0.1:22261.\r\nApp relay of relay: running on 127.0.0.1:61326. Read at ws://127.0.0.1:65186. Route g.toon.151cc3609b6b5c30.relay at price 1.\r\nSubscriptions held: 0 with a balance, 0 exhausted.\r\nSubscriber keys of its own relay with a balance: 0.\r\n"]
[195.91906, "o", "\r\n\u001b[1;33m# Provider: join the devnet. A peering toward its hub, with a deposit\u001b[0m\r\n"]
[195.919095, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon join devnet --deposit 1000000 --yes\r\n"]
[205.522556, "o", "Joined devnet: peered with https://proxy.relay.devnet.toonprotocol.dev/ilp and forwarding g.toon to it, deposit 1000000. Reading its relay at wss://relay-ws.devnet.toonprotocol.dev.\r\nIts connector forwards back to you only if its operator creates a peering toward you in return.\r\n"]
[205.526116, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon peer list\r\n"]
[206.124341, "o", "devnet (fee 0, cap 1000000)\r\n"]
[206.127665, "o", "\r\n\u001b[1;33m# Provider: put the Echo Merchant behind the connector, at price 2\u001b[0m\r\n"]
[206.127698, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon add echo --to relay --image ghcr.io/toon-protocol/echo-merchant:release --env ECHO_MERCHANT_ADDR=0.0.0.0:3100 --price 2 --yes\r\n"]
[213.730386, "o", "Added echo behind relay: packets to g.toon.151cc3609b6b5c30.echo are delivered to it, at price 2. The connector of relay restarted.\r\n"]
[213.734028, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon route list\r\n"]
[214.33203, "o", "g.toon.151cc3609b6b5c30.relay -> http://127.0.0.1:61326/write (price 1)\r\ng.toon.151cc3609b6b5c30.relay.ephemeral -> http://127.0.0.1:61326/write-ephemeral (price 0)\r\ng.toon.151cc3609b6b5c30.echo -> http://172.18.0.2:3100/ (price 2)\r\ng.toon -> peer devnet (price 0)\r\n"]
[214.335612, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon status | grep -E \"^(Supervisor|TOON app|App echo)\"\r\n"]
[214.933912, "o", "Supervisor: running.\r\nTOON app relay (ILP address g.toon.151cc3609b6b5c30): connector running on 127.0.0.1:22261.\r\nApp echo of relay: running on 172.18.0.2:3100. Read at ws://172.18.0.2:7100. Route g.toon.151cc3609b6b5c30.echo at price 2.\r\n"]
[215.54217, "o", "\r\n\u001b[1;33m# Payer: where it is. A different network: a Linode on the public internet\u001b[0m\r\n\u001b[1;36mlinode-payer#\u001b[0m curl -4 -fsS https://ifconfig.me; echo; hostname\r\n"]
[216.451871, "o", "45.33.87.160\r\n"]
[216.455698, "o", "localhost\r\n"]
[216.45725, "o", "\r\n\u001b[1;33m# Payer: read the provider's self-description through the Anyone overlay (free)\u001b[0m\r\n"]
[216.457303, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone; P='--password-file /root/.toon/password'; npx toon-client describe $P 2>&1 | grep -v -E '^toon-client: (downloading|verified)'\r\n"]
[234.944136, "o", "toon-client: http://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone is a hidden service; starting a local anon daemon\r\ntoon-client: starting anon v0.4.10.2 on 127.0.0.1:39657 (/root/.toon/anon/v0.4.10.2/anon)\r\ntoon-client: anon is listening; building circuits on demand\r\ntoon-client: proxying through socks5h://127.0.0.1:39657\r\n  connector  http://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone\r\n  addresses  g.toon.151cc3609b6b5c30\r\n  http       http://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone/ilp\r\n  btp        ws://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone/ilp/btp\r\n  seals to   0x04151cc3609b6b5c305c7120d7a40940fc974a4e2fa3a7cc088ca4029d333eae0df302d3ac1938f25cb2ddca9f10235401859a71222d918a434cfbb9def1b4b8a7 (key connector-signer)\r\n  versions   1 (default 1)\r\n\r\nChannels (x402 batch-settlement):\r\n  eip155:84532  payTo 0xaa078cfab21404715ad618c5e8b10674cda552ca  token 0x0c996d7c934c79a6255254875607fe69df25c0e1  min delay 86400s\r\n\r\nRoutes:\r\n  g.toon                                   0 (0 USDC)\r\n  g.toon.151cc3609b6b5c30.echo             2 (0.000002 USDC)\r\n  g.toon.151cc3609b6b5c30.relay            1 (0.000001 USDC)\r\n  g.toon.151cc3609b6b5c30.relay.ephemeral  0 (0 USDC)\r\n"]
[234.94561, "o", "\r\n\u001b[1;33m# Payer: test USDC from the devnet faucet, and a channel toward the provider (no gas)\u001b[0m\r\n"]
[234.94565, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone; P='--password-file /root/.toon/password'; npx toon-client faucet $P 2>&1 | grep -v '^toon-client:'\r\n"]
[248.635999, "o", "Faucet request accepted.\r\n  chain    evm\r\n  address  0xb01D6B0e2138b3Ac44502Df9cBd07845D3552217\r\n\r\nCheck it landed with 'toon-client balances'.\r\n"]
[248.637472, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone; P='--password-file /root/.toon/password'; npx toon-client channel open --deposit 100000 $P 2>&1 | grep -v '^toon-client:'\r\n"]
[259.626575, "o", "Channel open.\r\n  channel    0x60765c332b392b72e34107631d7ff898b66b16d0e1b2ddda72a78b3acae16c7d\r\n  network    eip155:84532\r\n  deposit    100000 (0.1 USDC)\r\n  signed     0 (0 USDC)\r\n  available  100000 (0.1 USDC)\r\n"]
[259.631801, "o", "\r\n\u001b[1;33m# Payer: one paid request to the Echo Merchant behind NAT\u001b[0m\r\n"]
[259.631866, "o", "\u001b[1;36mlinode-payer#\u001b[0m cd /root/payer; export TOON_CONNECTOR=http://ejaovyv6d7kgo3bbnjzpiihuraqpibxpwwsl65crgx5y4xwkff3gx6qd.anyone; P='--password-file /root/.toon/password'; npx toon-client send g.toon.151cc3609b6b5c30.echo --json-body --body '{\"hello\":\"from a linode\"}' $P 2>&1 | grep -v '^toon-client:'\r\n"]
[268.342556, "o", "FULFILL 200  (http)\r\n  paid        2 (0.000002 USDC)  channel 0x60765c332b392b72e34107631d7ff898b66b16d0e1b2ddda72a78b3acae16c7d\r\n  cumulative  2 (0.000002 USDC)\r\n\r\n  content-type:    application/json\r\n  content-length:  368\r\n  date:            Thu, 15 Oct 2026 15:02:42 GMT\r\n\r\n{\"payment\":{\"amount\":\"2\",\"chain\":\"evm\",\"payer\":\"evm:0x60765c332b392b72e34107631d7ff898b66b16d0e1b2ddda72a78b3acae16c7d\"},\"request\":{\"body\":\"{\\\"hello\\\":\\\"from a linode\\\"}\",\"body_encoding\":\"utf8\",\"headers\":{\"accept\":\"*/*\",\"accept-encoding\":\"gzip, br, deflate\",\"content-length\":\"25\",\"content-type\":\"application/json\",\"host\":\"172.18.0.2:3100\"},\"method\":\"POST\",\"path\":\"/\"}}\r\n"]
[268.344116, "o", "\r\n\u001b[1;33m# Provider: the channel the payment arrived on\u001b[0m\r\n\u001b[1;36mprovider-vm$\u001b[0m toon channel list\r\n"]
[269.387305, "o", "0x60765c332b392b72e34107631d7ff898b66b16d0e1b2ddda72a78b3acae16c7d evm inbound open (counterparty 0xb01d6b0e2138b3ac44502df9cbd07845d3552217, collateral 100000, landed 0, watermark 2)\r\n0x15db253fce8107554e2dcf20b8f934c0b2888f60a7acc0e66d3100c93a763bea evm outbound open (counterparty 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308, collateral 1000000, landed 0, watermark 0)\r\n"]
[269.99273, "o", "\r\n\u001b[1;33m# Provider: land the payer's voucher on Base Sepolia now, instead of at the next ten-minute sweep\u001b[0m\r\n\u001b[1;36mprovider-vm$\u001b[0m toon channel land 0x60765c332b392b72e34107631d7ff898b66b16d0e1b2ddda72a78b3acae16c7d\r\n"]
[276.59438, "o", "Landed: 0x60765c332b392b72e34107631d7ff898b66b16d0e1b2ddda72a78b3acae16c7d evm inbound open (counterparty 0xb01d6b0e2138b3ac44502df9cbd07845d3552217, collateral 99998, landed 2, watermark 2)\r\n"]
[276.597976, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel list | grep inbound\r\n"]
[282.199118, "o", "0x60765c332b392b72e34107631d7ff898b66b16d0e1b2ddda72a78b3acae16c7d evm inbound open (counterparty 0xb01d6b0e2138b3ac44502df9cbd07845d3552217, collateral 99998, landed 2, watermark 2)\r\n"]
[298.645616, "o", "\u001b[1;36mhost$\u001b[0m the claim on Base Sepolia, from the provider's settlement key\r\n"]
[298.940734, "o", "0x9c2b9aaa99f92af25acce2bad0bb5cc0c5b8b825df10cd22d11570e831d62f3d  claim\r\nhttps://sepolia.basescan.org/tx/0x9c2b9aaa99f92af25acce2bad0bb5cc0c5b8b825df10cd22d11570e831d62f3d\r\n"]
[298.940926, "o", "\r\n\u001b[1;33m# Provider: pay a devnet route from behind NAT, hop by hop: this node, the devnet relay, the gas station\u001b[0m\r\n"]
[298.941004, "o", "\u001b[1;36mprovider-vm$\u001b[0m echo \"{\\\"hello\\\":\\\"from behind NAT\\\"}\" > ~/body.json; toon probe g.toon.relay.gas --seal-to https://proxy.gas.devnet.toonprotocol.dev/ilp\r\n"]
[300.520246, "o", "Rejected with F06: 0 base units to g.toon.relay.gas. No payment channel claim attached (peer 'devnet' quotes 1001 for this packet, which carried only 0: raise the amount to at least 1001) The path costs 1001 base units: state `toon send --amount 1001`.\r\n"]
[300.5245, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon send g.toon.relay.gas --amount 1001 --seal-to https://proxy.gas.devnet.toonprotocol.dev/ilp --body ~/body.json --yes\r\n"]
[302.125082, "o", "Fulfilled: 1001 base units to g.toon.relay.gas. The app answered 422.\r\n"]
[302.128692, "o", "\u001b[1;36mprovider-vm$\u001b[0m toon channel list | grep outbound\r\n"]
[302.726811, "o", "0x15db253fce8107554e2dcf20b8f934c0b2888f60a7acc0e66d3100c93a763bea evm outbound open (counterparty 0x3f43d923a611bcb2d0bfb5d6ee2c3ac3efeaf308, collateral 1000000, landed 0, watermark 1001)\r\n"]
[302.730469, "o", "\r\n\u001b[1;33m# Provider VM: every listening TCP socket. All on loopback\u001b[0m\r\n\u001b[1;36mprovider-vm#\u001b[0m ss -tlnp\r\n"]
